# Copy to .env.local locally; configure these privately in Vercel for production.
NEXT_PUBLIC_SITE_URL=https://www.nscclothingstore.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# At least 10 characters; use a unique long password. Never NEXT_PUBLIC_.
ADMIN_PASSWORD=
# Optional owner notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
OWNER_EMAIL=
MAIL_FROM=
# Set true AFTER the shared-rate-limit migration has been verified.
NSC_REQUIRE_SHARED_RATE_LIMIT=false
